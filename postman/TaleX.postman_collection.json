{
  "info": {
    "name": "TaleX API",
    "description": "API de TaleX (talex_backend). Todas las rutas salvo /health piden Authorization: Bearer <Firebase ID token>.\n\n1. Llena las variables firebaseApiKey, email y password.\n2. Ejecuta \"Auth / Obtener token Firebase\": guarda {{token}} solo.\n3. El token dura 1 hora.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://talex-backend.vercel.app"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "firebaseApiKey",
      "value": ""
    },
    {
      "key": "email",
      "value": "talex.admin@talex.com.co"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "organizationId",
      "value": "77c243b3-720f-427c-9834-03ed440c1e24"
    },
    {
      "key": "applicationId",
      "value": ""
    },
    {
      "key": "vacancyId",
      "value": ""
    },
    {
      "key": "surveySlug",
      "value": "culture-perception"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Obtener token Firebase",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.idToken) {",
                  "  pm.collectionVariables.set(\"token\", body.idToken);",
                  "  console.log(\"token guardado\");",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{firebaseApiKey}}",
              "protocol": "https",
              "host": [
                "identitytoolkit",
                "googleapis",
                "com"
              ],
              "path": [
                "v1",
                "accounts:signInWithPassword"
              ],
              "query": [
                {
                  "key": "key",
                  "value": "{{firebaseApiKey}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"returnSecureToken\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Login con correo y contraseña en Firebase. Guarda idToken en la variable {{token}}."
          }
        },
        {
          "name": "Health",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Ping a MongoDB. No pide token."
          }
        }
      ]
    },
