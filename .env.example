PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:5000

# URI de MongoDB Atlas. El valor real va solo en `.env` o en Vercel.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/talex
MONGODB_DB=talex

FIREBASE_PROJECT_ID=talex-platform
# JSON de la service account, en una sola línea. Se carga en Vercel, no en git.
FIREBASE_SERVICE_ACCOUNT=

LOCAL_SUPERADMIN_EMAILS=talex.admin@talex.com.co

PUBLIC_SURVEY_BASE=https://platform.talex.com.co
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_PORT=587
CULTURE_REPORT_THRESHOLD=
