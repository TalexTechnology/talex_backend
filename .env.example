PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:5000

# En cPanel la API y MySQL están en el mismo servidor.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=talexcom_talex
MYSQL_USER=talexcom_talex_user
MYSQL_PASSWORD=

FIREBASE_PROJECT_ID=talex-platform
# JSON de la service account, en una sola línea. Se carga en cPanel, no en git.
FIREBASE_SERVICE_ACCOUNT=

LOCAL_SUPERADMIN_EMAILS=talex.admin@talex.com.co
